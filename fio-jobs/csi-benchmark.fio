[global]
ioengine=libaio
direct=1
time_based=0
size=256m
runtime=60

[seq-read]
rw=read
bs=1M
numjobs=1
iodepth=16

[seq-write]
rw=write
bs=1M
numjobs=1
iodepth=16

[rand-read-4k-qd1]
rw=randread
bs=4k
numjobs=1
iodepth=1

[rand-write-4k-qd1]
rw=randwrite
bs=4k
numjobs=1
iodepth=1

[rand-read-4k-qd16]
rw=randread
bs=4k
numjobs=4
iodepth=16

[rand-write-4k-qd16]
rw=randwrite
bs=4k
numjobs=4
iodepth=16

[fsync-latency]
rw=write
bs=4k
numjobs=1
iodepth=1
fsync=1
